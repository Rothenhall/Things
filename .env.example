# Copy to .env and edit. Every setting is optional except ADMIN_TOKEN if you want the dashboard.
# The Next.js app reads .env automatically. The collector (npm run collector) does too.

# ---- Your site ---------------------------------------------------------------
# Public URL, no trailing slash. Used for absolute links in llms.txt, sitemap.xml and JSON-LD.
# For the Next.js app set it at BUILD time too (metadataBase is baked in).
SITE_URL=
SITE_NAME=Things
SITE_DESCRIPTION=Build a 3D plush character. Change the fur, face and outfit, then boop it.

# ---- Content the chat answers from -------------------------------------------
# Markdown files (see content/). Front matter: title, description, path, type (page | faq).
CONTENT_DIR=content
# Optional: also crawl a live site. Same-origin pages only, max 50, refreshed hourly.
CONTENT_SITEMAP=
# Optional: or a fixed list of page URLs, comma separated.
CONTENT_URLS=

# ---- Admin dashboard ---------------------------------------------------------
# Long random string. Unset = dashboard disabled. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# The collector refuses the dashboard when a request looks proxied/tunnelled (default true for the collector,
# false for the Next.js app). Set explicitly to override.
ADMIN_LOCAL_ONLY=

# ---- Where data is stored ----------------------------------------------------
# JSONL files: questions.jsonl, bot-hits.jsonl, visits.jsonl. Back up by copying the folder.
DATA_DIR=data
# Each log rotates (keeps one old copy) after this many MB.
LOG_MAX_MB=10

# ---- Chat --------------------------------------------------------------------
# true  = visitors can ask the character questions (answers need content; fluent answers need LLM_API_KEY below).
# false = capture-only mode: the character is decoration, /api/chat is off, crawler and AI-referral tracking keep working.
CHAT_ENABLED=true
# Websites allowed to call /api/chat and /api/track from a browser. Comma separated origins,
# e.g. https://example.com,https://www.example.com. Unset = any site (fine for a demo, not for production).
ALLOWED_ORIGINS=
# Optional shared value the widget sends as data-key. A spam filter, not a secret.
SITE_KEY=
# Questions per visitor per minute.
CHAT_RATE_LIMIT=20
# Hard cap on LLM calls per day (then answers fall back to quoting your content). Protects your bill.
CHAT_DAILY_LLM_LIMIT=500
# What the character says when it cannot answer.
CHAT_FALLBACK=

# ---- Answer engine (optional) ------------------------------------------------
# Leave empty to quote the best matching passage from your content. No keys, no cost.
# openai    = any OpenAI-compatible API (OpenAI, OpenRouter, Ollama, LM Studio, vLLM ...)
# anthropic = the Anthropic API
# sarvam | gemini | groq | openrouter = ready-made defaults, you only add LLM_API_KEY
LLM_PROVIDER=
LLM_API_KEY=
# Ollama example: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2
LLM_BASE_URL=
LLM_MODEL=

# ---- AI traffic --------------------------------------------------------------
# Serve markdown instead of HTML to known AI crawlers (and to Accept: text/markdown, and /page.md).
MARKDOWN_FOR_BOTS=true
# allow | block. "block" adds Disallow rules for known AI crawlers to robots.txt.
AI_BOTS=allow
# Next.js app only: send crawler hits to a remote collector instead of this app.
# Example: COLLECTOR_URL=https://collector.example.com
COLLECTOR_URL=
# Next.js app only: how the middleware reaches this app's own tracker (default http://127.0.0.1:$PORT).
INTERNAL_URL=

# ---- Collector only ----------------------------------------------------------
COLLECTOR_PORT=8787
COLLECTOR_HOST=0.0.0.0
